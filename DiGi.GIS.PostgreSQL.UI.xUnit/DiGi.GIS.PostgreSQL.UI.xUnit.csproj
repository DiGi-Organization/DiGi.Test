<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>

    <OutputPath>..\bin\$(MSBuildProjectName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- WPF facts: Label, ListBox, ProgressBar mean the WPF controls; a file using Windows Forms imports it itself -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="Npgsql" Version="10.0.2" />
    <PackageReference Include="ProjNET4GeoAPI" Version="1.4.1" />
    <PackageReference Include="QuikGraph" Version="2.5.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
    <!-- IAsyncEnumerable is what every DiGi.GIS.IO reader returns, and both DiGi.GIS.IO and
         DiGi.GIS.PostgreSQL are referenced here by HintPath, so the package DiGi.GIS.PostgreSQL declares
         never reaches this output from NuGet. Without it the copy probed beside DiGi.GIS.IO.dll is the
         netstandard2.0 asset, which defines the interface instead of forwarding it to the framework, and
         every reader call fails with MissingMethodException. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.9" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiGi.Core.xUnit\DiGi.Core.xUnit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DiGi.Analytical">
      <HintPath>..\..\DiGi.Analytical\bin\DiGi.Analytical.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Analytical.Building">
      <HintPath>..\..\DiGi.Analytical\bin\DiGi.Analytical.Building.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.CityGML">
      <HintPath>..\..\DiGi.CityGML\bin\DiGi.CityGML.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Core">
      <HintPath>..\..\DiGi.Core\bin\DiGi.Core.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Core.IO">
      <HintPath>..\..\DiGi.Core\bin\DiGi.Core.IO.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Core.Parameter">
      <HintPath>..\..\DiGi.Core\bin\DiGi.Core.Parameter.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Core.Relation">
      <HintPath>..\..\DiGi.Core\bin\DiGi.Core.Relation.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.EPW">
      <HintPath>..\..\DiGi.EPW\bin\DiGi.EPW.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Geometry">
      <HintPath>..\..\DiGi.Geometry\bin\DiGi.Geometry.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Geometry.Object">
      <HintPath>..\..\DiGi.Geometry\bin\DiGi.Geometry.Object.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.GIS">
      <HintPath>..\..\DiGi.GIS\bin\DiGi.GIS.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.GIS.Analytical">
      <HintPath>..\..\DiGi.GIS.Analytical\bin\DiGi.GIS.Analytical.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.GIS.IO">
      <HintPath>..\..\DiGi.GIS.IO\bin\DiGi.GIS.IO.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.GIS.PostgreSQL">
      <HintPath>..\..\DiGi.GIS.PostgreSQL\bin\DiGi.GIS.PostgreSQL.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.GIS.PostgreSQL.UI">
      <HintPath>..\..\DiGi.GIS.PostgreSQL.UI\bin\DiGi.GIS.PostgreSQL.UI.dll</HintPath>
    </Reference>
    <!-- Needed by ExportPredictionImages_ByteParity for DiGi.GIS.UI.Modify.WriteImages, the file-based export pipeline it compares against. -->
    <Reference Include="DiGi.GIS.UI">
      <HintPath>..\..\DiGi.GIS.UI\bin\DiGi.GIS.UI.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.GIS.WebAPI">
      <HintPath>..\..\DiGi.GIS.WebAPI\bin\DiGi.GIS.WebAPI.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.GIS.YOLO">
      <HintPath>..\..\DiGi.GIS.YOLO\bin\DiGi.GIS.YOLO.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.GIS.YOLO.UI">
      <HintPath>..\..\DiGi.GIS.YOLO.UI\bin\DiGi.GIS.YOLO.UI.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Python">
      <HintPath>..\..\DiGi.Python\bin\DiGi.Python.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.YOLO">
      <HintPath>..\..\DiGi.YOLO\bin\DiGi.YOLO.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.PostgreSQL">
      <HintPath>..\..\DiGi.PostgreSQL\bin\DiGi.PostgreSQL.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.PostgreSQL.Table">
      <HintPath>..\..\DiGi.GIS.PostgreSQL\bin\DiGi.PostgreSQL.Table.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Serilog">
      <HintPath>..\..\DiGi.Serilog\bin\DiGi.Serilog.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.UI.Windows">
      <HintPath>..\..\DiGi.UI.Windows\bin\DiGi.UI.Windows.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.UI.WPF">
      <HintPath>..\..\DiGi.UI.WPF\bin\DiGi.UI.WPF.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.User">
      <HintPath>..\..\DiGi.User\bin\DiGi.User.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.User.PostgreSQL">
      <HintPath>..\..\DiGi.User.PostgreSQL\bin\DiGi.User.PostgreSQL.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.WebAPI">
      <HintPath>..\..\DiGi.WebAPI\bin\DiGi.WebAPI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
