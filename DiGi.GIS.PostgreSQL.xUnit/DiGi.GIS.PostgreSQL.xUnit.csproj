<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <OutputPath>..\bin\$(MSBuildProjectName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <!-- DiGi.Geometry is referenced by HintPath, so its NuGet dependencies do not flow to the test host. -->
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <!-- ProjNET4GeoAPI is a NuGet dependency of DiGi.GIS. The reprojection facts build one
         GeoAPI.CoordinateSystems.Transformations.ICoordinateTransformation per fact and name that type, so this
         project re-declares the package at the same version as DiGi.GIS.PostgreSQL (DiGi.GIS.PostgreSQL#125). -->
    <PackageReference Include="ProjNET4GeoAPI" Version="1.4.1" />
    <!-- DiGi.GIS.PostgreSQL.Energy reaches DiGi.Solar and DiGi.Geometry by HintPath, so their NuGet dependencies are re-declared here (Coding - Host Dependencies.md). -->
    <PackageReference Include="QuikGraph" Version="2.5.0" />
    <PackageReference Include="SolarCalculator" Version="3.6.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DiGi.GIS.PostgreSQL\DiGi.GIS.PostgreSQL\DiGi.GIS.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\DiGi.GIS.PostgreSQL\DiGi.GIS.PostgreSQL.Energy\DiGi.GIS.PostgreSQL.Energy.csproj" />
    <ProjectReference Include="..\DiGi.Core.xUnit\DiGi.Core.xUnit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DiGi.Analytical">
      <HintPath>..\..\DiGi.Analytical\bin\DiGi.Analytical.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Analytical.Building">
      <HintPath>..\..\DiGi.Analytical\bin\DiGi.Analytical.Building.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Analytical.Building.Energy">
      <HintPath>..\..\DiGi.Analytical\bin\DiGi.Analytical.Building.Energy.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Analytical.Building.Regulation">
      <HintPath>..\..\DiGi.Analytical\bin\DiGi.Analytical.Building.Regulation.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.BDL">
      <HintPath>..\..\DiGi.BDL\bin\DiGi.BDL.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.CityGML">
      <HintPath>..\..\DiGi.CityGML\bin\DiGi.CityGML.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Core">
      <HintPath>..\..\DiGi.Core\bin\DiGi.Core.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Core.IO">
      <HintPath>..\..\DiGi.Core\bin\DiGi.Core.IO.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Core.Parameter">
      <HintPath>..\..\DiGi.Core\bin\DiGi.Core.Parameter.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Core.Relation">
      <HintPath>..\..\DiGi.Core\bin\DiGi.Core.Relation.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.EPW">
      <HintPath>..\..\DiGi.EPW\bin\DiGi.EPW.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Geometry">
      <HintPath>..\..\DiGi.Geometry\bin\DiGi.Geometry.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Geometry.Object">
      <HintPath>..\..\DiGi.Geometry\bin\DiGi.Geometry.Object.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.GIS">
      <HintPath>..\..\DiGi.GIS\bin\DiGi.GIS.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.GIS.Analytical">
      <HintPath>..\..\DiGi.GIS.Analytical\bin\DiGi.GIS.Analytical.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.GIS.Analytical.Energy">
      <HintPath>..\..\DiGi.GIS.Analytical\bin\DiGi.GIS.Analytical.Energy.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.GIS.IO">
      <HintPath>..\..\DiGi.GIS.IO\bin\DiGi.GIS.IO.dll</HintPath>
    </Reference>
    <!-- DiGi.OSM is declared on this host because PostgreSQLOpenBuildingImportTask.Footprints carries a
         List<BuildingReadResult> in its signature (DiGi.GIS.PostgreSQL#169), so a fact calling it resolves
         the type at compile and at run time. The HintPath does not flow NuGet assets: the facts build an
         empty list and never read a PBF, so OsmSharp (what DiGi.OSM reads PBF through) is not required here
         (Coding - Host Dependencies.md). -->
    <Reference Include="DiGi.OSM">
      <HintPath>..\..\DiGi.OSM\bin\DiGi.OSM.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.PostgreSQL">
      <HintPath>..\..\DiGi.PostgreSQL\bin\DiGi.PostgreSQL.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.PostgreSQL.Table">
      <HintPath>..\..\DiGi.PostgreSQL\bin\DiGi.PostgreSQL.Table.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Typology">
      <HintPath>..\..\DiGi.Typology\bin\DiGi.Typology.dll</HintPath>
    </Reference>
    <Reference Include="DiGi.Weather">
      <HintPath>..\..\DiGi.Weather\bin\DiGi.Weather.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
